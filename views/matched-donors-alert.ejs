<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donor Shortlist & Alerts - VenaAether</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8f9fa; color: #333; padding: 30px; }
    .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }
    h1 { color: #d9534f; font-size: 24px; margin-bottom: 10px; }
    .patient-info { background: #fff5f5; border-left: 5px solid #d9534f; padding: 15px; border-radius: 6px; margin-bottom: 25px; }
    .patient-info p { margin: 5px 0; font-size: 14px; color: #444; }
    h3 { color: #2c3e50; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; font-size: 14px; }
    th { background-color: #2c3e50; color: white; }
    .badge { background: #e74c3c; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
    .btn { display: inline-block; background-color: #2c3e50; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 20px; font-size: 14px; }
    .btn:hover { background-color: #1a252f; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🚨 Emergency Alert Dispatched Successfully</h1>
    <p style="color: #666; margin-bottom: 20px;">System matched available donors based on blood group and local target zones (Chrompet, Tambaram Sanatorium, Pallavaram).</p>

    <div class="patient-info">
      <p><strong>Patient Name:</strong> <%= patient.patientName %></p>
      <p><strong>Required Blood Group:</strong> <span class="badge"><%= patient.bloodGroup %></span></p>
      <p><strong>Units Needed:</strong> <%= patient.unitsNeeded %> Unit(s)</p>
      <p><strong>Location:</strong> Rela Hospital, Chrompet</p>
      <p><strong>Shortlisted Donors Found:</strong> <strong><%= totalFound %></strong> active donor(s)</p>
    </div>

    <h3>Shortlisted Donors Notified via Mobile SMS:</h3>
    <% if (matchedDonors.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Donor Name</th>
            <th>Phone Number</th>
            <th>Location</th>
            <th>Blood Group</th>
            <th>Simulated Action Link</th>
          </tr>
        </thead>
        <tbody>
          <% matchedDonors.forEach(donor => { %>
            <tr>
              <td><%= donor.name %></td>
              <td><%= donor.phone %></td>
              <td><%= donor.location %></td>
              <td><strong><%= donor.bloodGroup %></strong></td>
              <td>
                <a href="<%= donor.acceptLink %>" target="_blank" style="color: #27ae60; font-weight: bold; margin-right: 10px; text-decoration: none;">[Simulate Accept]</a>
                <a href="<%= donor.denyLink %>" target="_blank" style="color: #c0392b; font-weight: bold; text-decoration: none;">[Simulate Deny]</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="color: #e74c3c; font-weight: bold; padding: 10px 0;">No matching donors found in Chrompet, Tambaram Sanatorium, or Pallavaram for blood group <%= patient.bloodGroup %>.</p>
    <% } %>

    <a href="/hospital/dashboard" class="btn">← Back to Admin Dashboard</a>
  </div>
</body>
</html>
